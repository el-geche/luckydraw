# Server port (the Vite dev server proxies /api to this)
PORT=4000
# JWT signing secret (change in any shared deployment)
JWT_SECRET=change-me-luckydraw-dev-secret
# Leave empty to use the embedded Postgres (PGlite) stored in server/.data/pglite.
# Set to a Postgres / Supabase connection string to use a real server, e.g.
# DATABASE_URL=postgres://luckydraw:luckydraw@localhost:5432/luckydraw
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=
# Set to "true" to force TLS for DATABASE_URL (auto-enabled for supabase.co hosts)
PGSSL=
# Demo payments: "simulated" (default, no network) or "stripe-test" (needs an sk_test_ key)
PAYMENTS_PROVIDER=simulated
STRIPE_SECRET_KEY=
# Scheduler tick (ms) that closes expired draws and runs auto-draws
SCHEDULER_INTERVAL_MS=2000
# Email (proof-of-entry receipts). Default "outbox": nothing leaves the machine —
# messages are written to server/.data/outbox/*.eml + *.html and shown in the in-app Demo outbox.
# Set MAIL_TRANSPORT=smtp plus SMTP_* to also deliver via a real SMTP server (e.g. Ethereal, Mailtrap).
MAIL_TRANSPORT=outbox
MAIL_FROM="LuckyDraw Demo <no-reply@luckydraw.demo>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Public URL used for links inside emails
APP_URL=http://localhost:5173
