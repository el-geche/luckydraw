{
  "name": "luckydraw",
  "version": "1.0.0",
  "private": true,
  "description": "LuckyDraw: a transparent, provably fair raffle platform (demo, no real money).",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "test": "npm test -w shared && npm test -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=18.18"
  }
}
